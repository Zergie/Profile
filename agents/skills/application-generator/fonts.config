<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "fonts.dtd">
<!-- application-generator fontconfig configuration v1
     Resolved by the renderer process only; the cache directory is set at
     runtime via the FC_CACHEDIR environment variable (fontcache/ below
     this file, excluded from version control). -->
<fontconfig>
    <!-- Windows system fonts directory: contains Calibri Regular, Bold,
         Italic, and Light. The renderer validates each face before rendering. -->
    <dir>C:/Windows/Fonts</dir>
</fontconfig>
