<!DOCTYPE html>
<html lang="{{ letter.language }}"><head><meta charset="utf-8"><title>{{ letter.name }} | {{ letter.subject }}</title><style>
@page { size: A4; margin: 0; } * { box-sizing: border-box; } body { margin: 0; color: #414143; font-family: Calibri, sans-serif; font-size: 10pt; line-height: 1.24; hyphens: none; } .page { width: 210mm; min-height: 297mm; padding: 20.5mm 21mm 18mm; background: #fff; } header { position: relative; height: 28mm; } h1 { margin: 0; font-size: 22pt; font-weight: 600; line-height: 1.08; text-transform: uppercase; } .subtitle { width: 105mm; margin: 2.1mm 0 0; font-size: 9pt; font-weight: 600; line-height: 1.32; text-transform: uppercase; } .contact { position: absolute; top: .4mm; right: 0; margin: 0; color: #555; font-size: 9pt; line-height: 1.25; text-align: right; } .contact span { display: block; } .hline { height: .7mm; margin-top: 5mm; border: 0; background: gray; } .recipient-row { display: flex; justify-content: space-between; align-items: start; margin-top: 1mm; font-size: 9pt; line-height: 1.24; } .recipient, .date { margin: 0; } .date { text-align: right; } .subject { margin: 13.5mm 0 7.5mm; font-size: 13.5pt; font-weight: 600; line-height: 1.1; } .salutation { margin: 0 0 4.2mm; } .body p { margin: 0 0 4.2mm; } .closing { margin: 4.2mm 0 0; } .signature { margin: 1mm 0 0; font-size: 10.5pt; font-weight: normal; } @media screen { html { background: #e5e5e5; } body { display: flex; justify-content: center; min-width: 210mm; padding: 12mm 0; } .page { flex: 0 0 auto; box-shadow: 0 1mm 3mm rgb(0 0 0 / 20%); } }
</style></head><body><main class="page"><header><h1>{{ letter.name }}</h1><p class="subtitle">{{ letter.subtitle }}</p><p class="contact"><span>{{ letter.address }}</span><span>{{ letter.phone }}</span><span>{{ letter.email }}</span></p><hr class="hline"></header><section class="recipient-row"><p class="recipient">{% for line in letter.recipient %}{% if loop.first %}<strong>{{ line }}</strong>{% else %}{{ line }}{% endif %}{% if not loop.last %}<br>{% endif %}{% endfor %}</p><p class="date">{{ letter.date }}</p></section><p class="subject">{{ letter.subject }}</p><p class="salutation">{{ letter.salutation }}</p><section class="body">{% for paragraph in letter.paragraphs %}<p>{{ paragraph }}</p>{% endfor %}</section><p class="closing">{% if letter.language == "de" %}Mit freundlichen Grüßen{% else %}Yours sincerely,{% endif %}</p><p class="signature">{{ letter.name }}</p></main></body></html>
